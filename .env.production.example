# Minimal production inputs. Copy to .env, protect it with chmod 600, and fill
# every empty value before starting. See .env.example for optional limits.
APP_ENV=production
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TARGET_PLATFORM=linux/amd64
REIMBURSEMENT_STAGING_DIR=/app/staging
REIMBURSEMENT_STAGING_MAX_BYTES=4294967296
REIMBURSEMENT_DRAFT_TTL_DAYS=30

DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_STORAGE_UPLOAD_TIMEOUT_SECONDS=120
DINGTALK_STORAGE_UPLOAD_HOST_SUFFIXES=trans.dingtalk.com
# Keep false until migrations, templates, permissions, and one acceptance run are verified.
# Set true explicitly in production only after those checks pass.
DINGTALK_OA_WORKER_ENABLED=false
DINGTALK_OA_WORKER_POLL_INTERVAL_SECONDS=1
DINGTALK_OA_WORKER_LEASE_SECONDS=180
DINGTALK_OA_WORKER_RETRY_BASE_SECONDS=5
DINGTALK_OA_WORKER_RETRY_MAX_SECONDS=300
DINGTALK_OA_WORKER_RECONCILIATION_SECONDS=900
# Optional; set only after verifying an absolute HTTPS/dingtalk URL containing
# exactly one {processInstanceId} placeholder for this DingTalk client/tenant.
DINGTALK_APPROVAL_DETAIL_URL_TEMPLATE=
SESSION_SECRET=
ADMIN_USER_IDS=
SESSION_COOKIE_SECURE=true

# Verified PP-OCR model directories must exist below this host path.
OCR_MODEL_HOST_DIR=./backend/models
